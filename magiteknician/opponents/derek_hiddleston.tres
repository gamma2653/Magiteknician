id = &"derek_hiddleston"
display_name = "Derek Hiddleston"
title = "Professor of Fluidic Magic"
introduction = "Derek works magic the way water finds its level: around, over and through. He is hard to pin down and harder to corner."
greeting = "I shan't stand where you want me. Nothing personal."
on_winning = "You aimed at where I was."
on_losing = "Well. That has not happened before."
